from ubi9
env PATH=$PATH:/root/kafka/bin
run yum install -y buildah podman git nmap bind-utils wget procps-ng net-tools lsof gcc make file iputils gdb java-21-openjdk fio
run cd; wget https://downloads.apache.org/kafka/4.1.1/kafka_2.13-4.1.1.tgz; mkdir kafka; tar xf kafka_2.13-4.1.1.tgz --strip-components=1 -C ./kafka
CMD /bin/sh -c "trap : TERM INT; sleep infinity & wait"


