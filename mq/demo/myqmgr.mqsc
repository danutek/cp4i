* =============================================================================
* Declarative MQSC Configuration for Native HA Queue Manager: MYQMGR
* Managed via GitHub Actions CI/CD (Ishanti Demo)
*
* Rules enforced by CI (mq/demo/scripts/validate-mqsc.sh):
*   1. All DEFINE statements must use REPLACE (idempotent deployments)
*   2. Application QLOCAL queues must set DEFPSIST(YES) for Native HA durability
*   3. Security controls (CHLAUTH / CONNAUTH) must remain enabled
*   4. Destructive commands (DELETE / CLEAR) are blocked by default
* =============================================================================

DEFINE QLOCAL('ISHANTI.DEMO.IN') +
       DESCR('Ishanti Native HA demo inbound queue - managed via GitOps') +
       DEFPSIST(YES) +
       MAXDEPTH(50000) +
       BOTHRESH(3) +
       BOQNAME('ISHANTI.DEMO.DLQ') +
       REPLACE

DEFINE QLOCAL('ISHANTI.DEMO.OUT') +
       DESCR('Ishanti Native HA demo outbound queue - managed via GitOps') +
       DEFPSIST(YES) +
       MAXDEPTH(50000) +
       REPLACE

DEFINE QLOCAL('ISHANTI.DEMO.DLQ') +
       DESCR('Ishanti Native HA demo dead-letter queue - managed via GitOps') +
       DEFPSIST(YES) +
       MAXDEPTH(50000) +
       REPLACE

DEFINE CHANNEL('ISHANTI.APP.SVRCONN') +
       CHLTYPE(SVRCONN) +
       TRPTYPE(TCP) +
       HBINT(60) +
       MAXMSGL(4194304) +
       DESCR('Ishanti Native HA demo application channel') +
       REPLACE
